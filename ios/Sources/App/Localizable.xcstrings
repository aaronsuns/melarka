{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "在后台从上次的位置继续播放；队列为空时随机播放收藏。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes where you left off, in the background; with an empty queue, shuffles your favorites."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台从上次的位置继续播放；队列为空时随机播放收藏。"
          }
        }
      }
    },
    "在后台随机播放收藏的歌曲；没有网络时播放已缓存的收藏。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffles your favorites in the background; with no network, the cached ones play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台随机播放收藏的歌曲；没有网络时播放已缓存的收藏。"
          }
        }
      }
    },
    "已在播放": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already playing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在播放"
          }
        }
      }
    },
    "未登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录"
          }
        }
      }
    },
    "正在随机播放收藏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffling favorites"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在随机播放收藏"
          }
        }
      }
    },
    "离线且没有缓存的歌曲": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline, and no songs are cached"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线且没有缓存的歌曲"
          }
        }
      }
    },
    "继续播放": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续播放"
          }
        }
      }
    },
    "请先打开 Melarka 并设置服务器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Melarka and set the server first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开 Melarka 并设置服务器"
          }
        }
      }
    },
    "随机播放收藏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle Favorites"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机播放收藏"
          }
        }
      }
    }
  },
  "version": "1.0"
}