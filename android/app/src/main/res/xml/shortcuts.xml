<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher shortcuts (iOS LarkShortcuts): both run in the background through ShortcutActivity, no page shown. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shuffle_favorites"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_shuffle"
        android:shortcutShortLabel="@string/shortcut_shuffle_favorites"
        android:shortcutLongLabel="@string/shortcut_shuffle_favorites">
        <intent
            android:action="lark.action.SHUFFLE_FAVORITES"
            android:targetPackage="io.github.aaronsuns.melarka"
            android:targetClass="lark.car.ShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="resume"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_resume"
        android:shortcutShortLabel="@string/shortcut_resume"
        android:shortcutLongLabel="@string/shortcut_resume">
        <intent
            android:action="lark.action.RESUME"
            android:targetPackage="io.github.aaronsuns.melarka"
            android:targetClass="lark.car.ShortcutActivity" />
    </shortcut>
</shortcuts>
