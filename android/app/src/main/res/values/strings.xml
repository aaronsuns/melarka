    <!-- Car autoplay, in Settings; the hints by phone maker come from CarAutoplay.vendorHint. -->
    <string name="car_autoplay_title">Car autoplay</string>
    <string name="car_autoplay_explain">When your car\'s Bluetooth connects, Melarka shuffles your favorites, even in the background. If music is already playing, nothing changes. Android asks you once to confirm the car.</string>
    <string name="car_autoplay_choose">Choose your car</string>
    <string name="car_autoplay_permission">To list the cars paired with this phone, Melarka needs the Nearby devices permission.</string>
    <string name="car_autoplay_old_android">On this Android version, Melarka notices the car only while it is allowed to run in the background. If autoplay doesn\'t start, set Melarka\'s battery usage to Unrestricted.</string>
    <string name="car_autoplay_hint_generic">If autoplay doesn\'t start or music stops with the screen off, set Melarka\'s battery usage to Unrestricted: Settings › Apps › Melarka › Battery.</string>
    <string name="car_autoplay_hint_xiaomi">On Xiaomi, Redmi and POCO phones, also turn on Autostart for Melarka (Settings › Apps › Manage apps › Melarka) and set its Battery saver to No restrictions.</string>
    <string name="car_autoplay_hint_huawei">On Huawei and Honor phones, open Settings › Battery › App launch, set Melarka to Manage manually and turn on all three switches.</string>
    <string name="car_autoplay_hint_oppo">On OPPO, realme and OnePlus phones, allow Melarka to auto-launch and allow its background activity (Settings › Apps › Melarka › Battery).</string>
    <string name="car_autoplay_hint_vivo">On vivo and iQOO phones, allow Autostart for Melarka and allow its high background power consumption (Settings › Battery).</string>
    <string name="car_autoplay_hint_samsung">On Samsung phones, add Melarka to Never sleeping apps: Settings › Battery › Background usage limits.</string>
