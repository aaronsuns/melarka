<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's copy of src/main/res/xml/network_security_config.xml (keep them the same) plus the emulator's
     host loopback, 10.0.2.2, over plain http, for the smoke test's local server. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- On purpose (the owner's call, android-client-design.md): self-hosted servers behind a private CA. -->
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="system" />
            <!-- On purpose (the owner's call, android-client-design.md): self-hosted servers behind a private CA. -->
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </domain-config>
</network-security-config>
